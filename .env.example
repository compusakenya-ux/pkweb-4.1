# ============================================================================
# SENA MOBILITY — GOOGLE CLOUD PLATFORM (GCP) & META BUSINESS CONFIGURATION
# ============================================================================

# --- Server Runtime (Cloud Run injects PORT=8080 automatically) ---
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# --- Google Cloud Platform (GCP) Configuration ---
GCP_PROJECT_ID=sena-mobility-ke-prod
GCP_REGION=africa-south1
GCP_SECONDARY_REGION=europe-west1
GCS_ASSETS_BUCKET=sena-mobility-3d-assets-prod
GCS_CDN_BASE_URL=https://storage.googleapis.com/sena-mobility-3d-assets-prod
ENABLE_GCP_CLOUD_LOGGING=true
ENABLE_GCP_SECRET_MANAGER=false
# Set local path only when testing outside GCP without ADC:
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# --- Meta Business Account & WhatsApp Cloud API (Graph API v21.0) ---
META_GRAPH_API_VERSION=v21.0
META_BUSINESS_ACCOUNT_ID=104829104928174
META_WABA_ID=109482716492810
META_PHONE_NUMBER_ID=118492019482719
META_WHATSAPP_DISPLAY_NUMBER=254700736200
META_WHATSAPP_ACCESS_TOKEN=EAAGm0PX4ZCpsBA...REPLACE_WITH_META_SYSTEM_USER_TOKEN
META_WEBHOOK_VERIFY_TOKEN=sena_mombasa_meta_verify_2026
META_APP_SECRET=replace_with_meta_app_secret_hmac_sha256

# --- Company & Ecosystem Contacts (Poughkeepsie Limited) ---
COMPANY_NAME="Poughkeepsie Limited"
PRODUCT_NAME="SENA Transit"
CONTACT_TEL="+254700736200"
CONTACT_EMAIL="info@poughkeepsie.co.ke"
